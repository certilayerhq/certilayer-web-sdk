{
  "name": "@certilayer/web",
  "version": "1.3.1",
  "type": "module",
  "description": "CertiLayer Web SDK \u2014 passive behavioral biometrics < 20KB",
  "main": "dist/certilayer.cjs",
  "module": "dist/certilayer.esm.js",
  "browser": "dist/certilayer.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/certilayer.esm.js",
      "require": "./dist/certilayer.cjs",
      "browser": "./dist/certilayer.min.js",
      "default": "./dist/certilayer.esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.13.0",
    "rollup-plugin-dts": "^6.1.0",
    "typescript": "^5.4.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
